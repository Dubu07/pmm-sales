{
  "name": "pmm-sales-invoice-system",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prisma:generate": "prisma generate",
    "db:local:apply": "wrangler d1 migrations apply pmm-sales-db --local",
    "db:remote:apply": "wrangler d1 migrations apply pmm-sales-db --remote",
    "postinstall": "prisma generate",
    "check:cf": "opennextjs-cloudflare build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@prisma/adapter-d1": "6.19.0",
    "@prisma/client": "6.19.0",
    "exceljs": "^4.4.0",
    "next": "^16.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "4.120.0"
  }
}
